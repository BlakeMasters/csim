{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "urn:cellsim-v2:credibility-template",
  "title": "Unqualified credibility template",
  "required": [
    "schema_version",
    "status",
    "runnable",
    "question_ref",
    "context_of_use_ref",
    "model_fingerprint",
    "qoi_ref",
    "numerical_verification_refs",
    "independent_comparator_refs",
    "calibration_refs",
    "experimental_validation_refs",
    "uncertainty_model_ref",
    "applicability_domain_ref",
    "known_limitations",
    "reviewer",
    "review_date",
    "biological_validation"
