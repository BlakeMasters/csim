    },
    "runnable": {
      "const": false
    },
    "question_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "context_of_use_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_fingerprint": {
      "type": [
        "string",
        "null"
      ]
    },
    "qoi_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "numerical_verification_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "independent_comparator_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "calibration_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "experimental_validation_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uncertainty_model_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "applicability_domain_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "known_limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reviewer": {
      "type": [
        "string",
        "null"
      ]
    },
    "review_date": {
      "type": [
        "string",
        "null"
